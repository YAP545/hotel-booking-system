# =================================================================
# Grand Hotel System - Environment Variables Template
# Copy this file to .env in your backend directory and update values
# =================================================================

# Database Configuration (MySQL 8.0)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=hotel_user
DATABASE_PASSWORD=your_database_password_here
DATABASE_NAME=hotel_booking

# Redis Configuration (Redis 7.0)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets & Expiry
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=15m

# Email Service (SMTP Configuration)
# Leave SMTP_HOST empty to operate in explicit console mock-logger mode
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@grandhotel.com

# Razorpay Online Payment Gateway (Test or Live Mode)
# Get Key ID & Key Secret from Razorpay Dashboard -> Test Mode -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_secret_here

# Get Webhook Secret from Razorpay Dashboard -> Test Mode -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend Configuration (Vite Environment Variables)
VITE_API_URL=http://localhost:3000/api
VITE_RAZORPAY_KEY_ID=rzp_test_xxxx
