DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=hotel_user
DATABASE_PASSWORD=hotel_password
DATABASE_NAME=hotel_booking

JWT_SECRET=hotel_booking_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=8h

PORT=3000
CORS_ORIGIN=http://localhost:5173

# SMTP Email Configuration (If left blank, emails operate in explicit mock-logger mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@grandhotel.com

# Razorpay Online Payment Gateway Config
# Get Key ID & Key Secret from Razorpay Dashboard -> Test Mode -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_secret_here

# Get Webhook Secret from Razorpay Dashboard -> Test Mode -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional Hotel UPI VPA for Fallback QR code (e.g. hotelname@upi)
HOTEL_UPI_VPA=hotelname@upi
